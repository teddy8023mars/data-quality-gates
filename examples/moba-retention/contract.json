{
  "version": 1,
  "required_columns": [
    "cohort_date",
    "day_offset",
    "cohort_users",
    "retained_users",
    "retention_rate"
  ],
  "empty_policy": "fail",
  "checks": [
    {
      "id": "all_present",
      "type": "not_null",
      "columns": [
        "cohort_date",
        "day_offset",
        "cohort_users",
        "retained_users",
        "retention_rate"
      ]
    },
    {
      "id": "cohort_grain",
      "type": "unique",
      "columns": [
        "cohort_date",
        "day_offset"
      ]
    },
    {
      "id": "supported_offsets",
      "type": "allowed_values",
      "column": "day_offset",
      "values": [
        "1",
        "7"
      ]
    },
    {
      "id": "nonempty_cohort",
      "type": "numeric_range",
      "column": "cohort_users",
      "min": 1
    },
    {
      "id": "nonnegative_retained",
      "type": "numeric_range",
      "column": "retained_users",
      "min": 0
    },
    {
      "id": "bounded_rate",
      "type": "numeric_range",
      "column": "retention_rate",
      "min": 0,
      "max": 1
    },
    {
      "id": "retained_within_cohort",
      "type": "column_compare",
      "left_column": "retained_users",
      "right_column": "cohort_users",
      "operator": "<="
    }
  ]
}
